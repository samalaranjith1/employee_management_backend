+                month: "long",
+                day: "numeric",
+              })}
+            </span>
+          </div>
+          <h1 className="text-4xl font-bold mb-4">{topicDetail.title}</h1>
+          <p className="text-xl text-blue-100 mb-4">
+            {topicDetail.description}
+          </p>
