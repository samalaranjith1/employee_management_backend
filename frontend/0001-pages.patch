+            ) : (
+              <Navigate to="/login" replace />
+            )
+          }
+        />
+
+        <Route
+          path="/health-info/:id"
+          element={
+            isAuthenticated ? (
+              hasConsent ? (
+                <HealthTopicDetail />
+              ) : (
+                <Navigate to="/privacy-consent" replace />
+              )
+            ) : (
+              <Navigate to="/login" replace />
+            )
+          }
+        />
+
+        <Route
+          path="/health-topics"
+          element={
+            isAuthenticated ? (
+              hasConsent ? (
+                <HealthTopics />
+              ) : (
+                <Navigate to="/privacy-consent" replace />
+              )
