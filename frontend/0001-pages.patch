+                      Distribution by Year
+                    </h3>
+                    <ResponsiveContainer width="100%" height={300}>
+                      <PieChart>
+                        <Pie
+                          data={pieData}
+                          cx="50%"
+                          cy="50%"
+                          labelLine={false}
+                          label={(entry) =>
+                            `${entry.name}: ${(entry.value / 1000000).toFixed(
+                              1
+                            )}M`
