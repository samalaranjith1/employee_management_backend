+                    <BarChart data={topicDetail.statistics}>
+                      <CartesianGrid strokeDasharray="3 3" />
+                      <XAxis dataKey="year" />
+                      <YAxis />
+                      <Tooltip
+                        formatter={(value: number) => value.toLocaleString()}
